{
  "name": "poll-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:dist": "playwright test --config playwright.dist.config.ts",
    "test:e2e:browsers": "playwright test --config playwright.browsers.config.ts",
    "check:file-length": "node scripts/check-file-length.mts",
    "test:db": "bash scripts/test-database.sh",
    "test:scripts": "bash scripts/test-security-scripts.sh"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@fontsource-variable/mulish": "5.3.0",
    "@fontsource/nerko-one": "5.3.0",
    "@fontsource/nokora": "5.3.0",
    "@supabase/supabase-js": "2.117.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "angular-eslint": "22.5.0",
    "eslint": "^10.12.0",
    "eslint-plugin-jsdoc": "64.5.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0"
  }
}
